      "AuditListResponse": {
        "type": "object",
        "required": ["agent_id", "events", "next_cursor", "filters"],
        "properties": {
          "agent_id": {
            "$ref": "#/components/schemas/AgentId"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEvent"
            }
          },
          "next_cursor": {
            "type": ["integer", "null"]
          },
          "filters": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "TokenScope": {
        "type": "string",
        "enum": ["identity:read", "audit:read", "branches:read", "tokens:read", "tokens:write"]
      },
      "CreateTokenRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "scopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TokenScope"
            }
          },
          "ttl_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 31536000
          },
          "expires_at": {
            "$ref": "#/components/schemas/Timestamp"
          }
        },
        "additionalProperties": false
      },
      "CreateTokenResponse": {
        "type": "object",
        "required": ["success", "token", "token_id", "agent_id", "name", "scopes", "created_at", "expires_at"],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "token": {
            "type": "string",
            "pattern": "^ntai_[A-Za-z0-9_-]{32,128}$"
          },
          "token_id": {
            "type": "string"
          },
          "agent_id": {
            "$ref": "#/components/schemas/AgentId"
          },
          "name": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TokenScope"
            }
          },
          "created_at": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "expires_at": {
            "$ref": "#/components/schemas/Timestamp"
          }
        }
      },
      "TokenMetadata": {
        "type": "object",
        "required": ["token_id", "name", "scopes", "created_at", "expires_at", "last_used_at", "revoked_at"],
        "properties": {
          "token_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TokenScope"
            }
          },
          "created_at": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "expires_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "last_used_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "revoked_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "TokenListResponse": {
        "type": "object",
        "required": ["agent_id", "tokens"],
        "properties": {
          "agent_id": {
            "$ref": "#/components/schemas/AgentId"
          },
          "tokens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TokenMetadata"
            }
          }
        }
      },
      "RevokeTokenResponse": {
        "type": "object",
        "required": ["success", "token_id", "revoked_at"],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "token_id": {
            "type": "string"
          },
          "revoked_at": {
            "$ref": "#/components/schemas/Timestamp"
          }
        }
      },
      "OverviewResponse": {
        "type": "object",
        "required": ["agent_id", "fetched_at", "auth", "hosting", "identity", "branches", "tokens", "audit"],
        "properties": {
          "agent_id": {
            "$ref": "#/components/schemas/AgentId"
          },
          "fetched_at": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "auth": {
            "type": "object",
            "additionalProperties": true
          },
          "hosting": {
            "type": "object",
            "additionalProperties": true
          },
          "identity": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/IdentitySignals"
              },
              {
                "type": "null"
              }
            ]
          },
          "branches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BranchSummary"
            }
          },
          "tokens": {
            "type": "object",
            "additionalProperties": true
          },
          "audit": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "HealthCheck": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "warning", "error"]
          },
          "latency_ms": {
            "type": "number"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": ["status", "service", "timestamp", "checks"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "degraded"]
          },
          "service": {
            "type": "string"
          },
          "timestamp": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/HealthCheck"
            }
          }
        }
      }
    }
  }
}
