---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SDK | NEWTYPE AI" description="SDK resources for verifying agent identity with Newtype.">
  <div class="bg-white">
    <section class="max-w-5xl mx-auto px-8 pt-20 pb-12">
      <div class="grid lg:grid-cols-[minmax(0,1fr)_360px] gap-12 items-end">
        <div class="space-y-6">
          <p class="text-xs text-gray-400 tracking-[0.22em]">SDK</p>
          <h1 class="text-2xl md:text-3xl font-light tracking-widest text-gray-900">Verify agent identity in your app.</h1>
          <div class="w-12 h-px bg-gray-300"></div>
          <p class="max-w-2xl text-lg text-gray-700 tracking-wide font-light leading-relaxed">The SDK is part of the developer workflow with nit. Use the combined Developers page for CLI, SDK, HTTP API, examples, and testing tools.</p>
        </div>
        <div class="rounded-lg border border-gray-100 p-5">
          <p class="text-xs text-gray-400 tracking-wider">NEXT</p>
          <a href="/developers#sdk" class="mt-4 block rounded-lg bg-gray-950 px-4 py-3 text-center text-sm font-light tracking-wide text-white transition-colors hover:bg-gray-800">Open Developers SDK</a>
          <a href="/verify" class="mt-3 block rounded-lg border border-gray-100 px-4 py-3 text-center text-sm font-light tracking-wide text-gray-600 transition-colors hover:border-gray-300">Test a payload</a>
        </div>
      </div>
    </section>
  </div>
</Layout>
