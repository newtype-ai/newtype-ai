---
import Layout from '../layouts/Layout.astro';
---

<Layout title="nit-sdk | NEWTYPE AI" description="nit-sdk is part of the Newtype developer workflow for verifying agent identity in apps.">
  <div class="bg-white">
    <section class="max-w-5xl mx-auto px-8 pt-20 pb-12">
      <div class="grid lg:grid-cols-[minmax(0,1fr)_360px] gap-12 items-end">
        <div class="space-y-6">
          <p class="text-xs text-gray-400 tracking-[0.22em]">SDK</p>
          <h1 class="text-2xl md:text-3xl font-light tracking-widest text-gray-900">App verification lives in Developers.</h1>
          <div class="w-12 h-px bg-gray-300"></div>
          <p class="max-w-2xl text-lg text-gray-700 tracking-wide font-light leading-relaxed">nit-sdk is not a separate product surface. It is the app side of the nit workflow: agents create identity locally, apps verify it with one call.</p>
        </div>
        <div class="rounded-lg border border-gray-100 p-5">
          <p class="text-xs text-gray-400 tracking-wider">INSTALL</p>
          <pre class="mt-4 overflow-x-auto rounded-lg bg-gray-950 p-4 text-xs text-gray-300"><code>npm install @newtype-ai/nit-sdk</code></pre>
          <a href="/developers#sdk" class="mt-5 block rounded-lg bg-gray-950 px-4 py-3 text-center text-sm font-light tracking-wide text-white transition-colors hover:bg-gray-800">Open SDK section</a>
        </div>
      </div>
    </section>

    <div class="max-w-5xl mx-auto px-8"><div class="h-px bg-gray-100"></div></div>

    <section class="max-w-5xl mx-auto px-8 py-12">
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/developers#workflow" class="rounded-lg border border-gray-100 p-5 transition-colors hover:border-gray-300">
          <p class="text-xs text-gray-400 tracking-wider">FLOW</p>
          <p class="mt-3 text-sm text-gray-900 font-light tracking-wide">Agent to app login</p>
          <p class="mt-2 text-xs text-gray-500 font-light leading-relaxed">See how nit and nit-sdk work together across identity creation, hosting, verification, and authorization.</p>
        </a>
        <a href="/developers#sdk" class="rounded-lg border border-gray-100 p-5 transition-colors hover:border-gray-300">
          <p class="text-xs text-gray-400 tracking-wider">SDK</p>
          <p class="mt-3 text-sm text-gray-900 font-light tracking-wide">Verify payloads</p>
          <p class="mt-2 text-xs text-gray-500 font-light leading-relaxed">Use <code class="text-xs bg-gray-50 px-1.5 py-0.5 rounded">verifyAgent</code>, policy checks, and returned identity state.</p>
        </a>
        <a href="/developers#api" class="rounded-lg border border-gray-100 p-5 transition-colors hover:border-gray-300">
          <p class="text-xs text-gray-400 tracking-wider">API</p>
          <p class="mt-3 text-sm text-gray-900 font-light tracking-wide">Call HTTP directly</p>
          <p class="mt-2 text-xs text-gray-500 font-light leading-relaxed">Use the verification endpoint without the SDK when you need full transport control.</p>
        </a>
      </div>
    </section>
  </div>
</Layout>
