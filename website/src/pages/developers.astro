---
import Layout from '../layouts/Layout.astro';

const flow = [
  ['01', 'Create identity locally', 'Agents use nit to create a keypair, agent ID, wallet addresses, and an agent-card.json in their working folder.'],
  ['02', 'Publish hosted state', 'nit pushes the card to newtype-ai.org so apps can fetch a stable public URL and branch-specific views.'],
  ['03', 'Verify in the app', 'Apps use nit-sdk or the HTTP API to verify signed login payloads and apply their own admission policy.'],
  ['04', 'Operate the relationship', 'The app receives card data, wallet addresses, identity signals, read tokens, and server attestation.'],
];

const returns = [
  ['verified', 'Cryptographic signature check passed.'],
  ['admitted', 'The identity satisfied your policy.'],
  ['card', 'Agent name, description, skills, provider, and public key.'],
  ['wallet', 'Solana and EVM addresses derived from the identity.'],
  ['identity', 'Age, login counts, machine/IP signals, and domain state.'],
  ['readToken', 'Time-limited token for card and branch access.'],
];

const commands = [
  ['nit init', 'Create local identity and agent card.'],
  ['nit commit', 'Commit card changes to local history.'],
  ['nit push', 'Publish the current branch to hosting.'],
  ['nit branch', 'Create and manage app-specific personas.'],
  ['nit sign --login app.com', 'Create a signed login payload for an app.'],
  ['nit wallet', 'Show derived chain addresses.'],
];
---

<Layout title="Developers | NEWTYPE AI" description="Build with nit and nit-sdk: local agent identity for agents, verification and authorization for apps.">
  <div class="bg-white">
    <section class="max-w-6xl mx-auto px-8 pt-20 pb-12">
      <div class="grid lg:grid-cols-[minmax(0,1fr)_380px] gap-12 items-end">
        <div class="space-y-6">
          <p class="text-xs text-gray-400 tracking-[0.22em]">NIT + SDK</p>
          <h1 class="text-2xl md:text-3xl font-light tracking-widest text-gray-900">Developers</h1>
          <div class="w-12 h-px bg-gray-300"></div>
          <p class="max-w-2xl text-lg text-gray-700 tracking-wide font-light leading-relaxed">One workflow for agents and apps: create the identity locally, host the card remotely, verify it from any app.</p>
        </div>
        <div class="rounded-lg border border-gray-100 bg-white p-5">
          <p class="text-xs text-gray-400 tracking-wider">INSTALL</p>
          <pre class="mt-4 overflow-x-auto rounded-lg bg-gray-950 p-4 text-xs text-gray-300"><code>npm install -g @newtype-ai/nit
npm install @newtype-ai/nit-sdk</code></pre>
        </div>
      </div>
    </section>

    <div class="max-w-6xl mx-auto px-8"><div class="h-px bg-gray-100"></div></div>

    <section class="max-w-6xl mx-auto px-8 py-12">
      <div class="grid lg:grid-cols-[220px_minmax(0,1fr)] gap-12">
        <aside class="hidden lg:block">
          <nav class="sticky top-24 space-y-8" aria-label="Developer sections">
            <div class="space-y-3">
              <p class="text-xs text-gray-400 tracking-wider">BUILD</p>
              <a href="#workflow" class="block text-sm text-gray-600 font-light hover:text-gray-900 transition-colors">Workflow</a>
              <a href="#cli" class="block text-sm text-gray-600 font-light hover:text-gray-900 transition-colors">CLI</a>
              <a href="#sdk" class="block text-sm text-gray-600 font-light hover:text-gray-900 transition-colors">SDK</a>
              <a href="#api" class="block text-sm text-gray-600 font-light hover:text-gray-900 transition-colors">HTTP API</a>
              <a href="#testing" class="block text-sm text-gray-600 font-light hover:text-gray-900 transition-colors">Testing</a>
            </div>
            <div class="space-y-3">
              <p class="text-xs text-gray-400 tracking-wider">LINKS</p>
              <a href="https://github.com/newtype-ai/nit" target="_blank" rel="noopener" class="block text-sm text-gray-600 font-light hover:text-gray-900 transition-colors">nit GitHub</a>
              <a href="https://github.com/newtype-ai/nit-sdk" target="_blank" rel="noopener" class="block text-sm text-gray-600 font-light hover:text-gray-900 transition-colors">SDK GitHub</a>
              <a href="/docs" class="block text-sm text-gray-600 font-light hover:text-gray-900 transition-colors">API docs</a>
            </div>
          </nav>
        </aside>

        <div class="min-w-0 space-y-20">
          <nav class="lg:hidden flex gap-5 overflow-x-auto pb-2" aria-label="Developer sections">
            <a href="#workflow" class="shrink-0 text-xs text-gray-500 tracking-wider">WORKFLOW</a>
            <a href="#cli" class="shrink-0 text-xs text-gray-500 tracking-wider">CLI</a>
            <a href="#sdk" class="shrink-0 text-xs text-gray-500 tracking-wider">SDK</a>
            <a href="#api" class="shrink-0 text-xs text-gray-500 tracking-wider">API</a>
            <a href="#testing" class="shrink-0 text-xs text-gray-500 tracking-wider">TESTING</a>
          </nav>

          <section id="workflow" class="scroll-mt-24 space-y-8">
            <div class="flex items-baseline justify-between gap-6">
              <h2 class="text-xl font-light tracking-widest text-gray-900">WORKFLOW</h2>
              <span class="hidden sm:block h-px flex-1 bg-gray-100"></span>
            </div>
            <div class="grid md:grid-cols-4 gap-4">
              {flow.map(([step, title, copy]) => (
                <div class="rounded-lg border border-gray-100 p-5">
                  <p class="text-xs text-gray-300 tracking-wider">{step}</p>
                  <p class="mt-4 text-sm text-gray-900 font-light tracking-wide">{title}</p>
                  <p class="mt-2 text-xs text-gray-500 font-light leading-relaxed">{copy}</p>
                </div>
              ))}
            </div>
          </section>

          <section id="cli" class="scroll-mt-24 space-y-8">
            <div class="flex items-baseline justify-between gap-6">
              <h2 class="text-xl font-light tracking-widest text-gray-900">CLI</h2>
              <span class="hidden sm:block h-px flex-1 bg-gray-100"></span>
            </div>
            <div class="grid lg:grid-cols-[minmax(0,1fr)_320px] gap-4">
              <div class="rounded-lg border border-gray-100 p-5">
                <p class="text-xs text-gray-400 tracking-wider">LOCAL IDENTITY</p>
                <pre class="mt-4 overflow-x-auto rounded-lg bg-gray-950 p-5 text-xs text-gray-300"><code>npx @newtype-ai/nit init
nit commit -m "initial identity"
nit push
nit sign --login your-app.com</code></pre>
              </div>
              <div class="grid gap-3">
                {commands.map(([name, copy]) => (
                  <div class="rounded-lg border border-gray-100 p-4">
                    <code class="text-xs text-gray-900">{name}</code>
                    <p class="mt-2 text-xs text-gray-500 font-light leading-relaxed">{copy}</p>
                  </div>
                ))}
              </div>
            </div>
          </section>

          <section id="sdk" class="scroll-mt-24 space-y-8">
            <div class="flex items-baseline justify-between gap-6">
              <h2 class="text-xl font-light tracking-widest text-gray-900">SDK</h2>
              <span class="hidden sm:block h-px flex-1 bg-gray-100"></span>
            </div>
            <div class="grid lg:grid-cols-2 gap-4">
              <div class="rounded-lg border border-gray-100 p-5">
                <p class="text-xs text-gray-400 tracking-wider">VERIFY LOGIN</p>
                <pre class="mt-4 overflow-x-auto rounded-lg bg-gray-950 p-5 text-xs text-gray-300"><code>import {"{"} verifyAgent {"}"} from '@newtype-ai/nit-sdk';

const result = await verifyAgent(payload, {"{"}
  policy: {"{"}
    max_identities_per_machine: 10,
    min_age_seconds: 5
  {"}"}
{"}"});

if (result.verified && result.admitted) {"{"}
  createSession(result.agent_id);
{"}"}</code></pre>
              </div>
              <div class="rounded-lg border border-gray-100 p-5">
                <p class="text-xs text-gray-400 tracking-wider">RETURNED STATE</p>
                <div class="mt-4 grid sm:grid-cols-2 gap-3">
                  {returns.map(([name, copy]) => (
                    <div class="rounded-lg border border-gray-50 p-3">
                      <code class="text-xs text-gray-900">{name}</code>
                      <p class="mt-2 text-xs text-gray-500 font-light leading-relaxed">{copy}</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </section>

          <section id="api" class="scroll-mt-24 space-y-8">
            <div class="flex items-baseline justify-between gap-6">
              <h2 class="text-xl font-light tracking-widest text-gray-900">HTTP API</h2>
              <span class="hidden sm:block h-px flex-1 bg-gray-100"></span>
            </div>
            <div class="rounded-lg border border-gray-100 p-5">
              <div class="flex flex-wrap items-center gap-3">
                <span class="rounded bg-emerald-50 px-2 py-1 font-mono text-xs text-emerald-700">POST</span>
                <code class="break-all text-sm text-gray-700">https://api.newtype-ai.org/agent-card/verify</code>
              </div>
              <div class="mt-5 grid lg:grid-cols-2 gap-4">
                <pre class="overflow-x-auto rounded-lg bg-gray-950 p-5 text-xs text-gray-300"><code>{"{"}
  "agent_id": "...",
  "domain": "your-app.com",
  "timestamp": 1719000000,
  "signature": "base64...",
  "public_key": "ed25519:...",
  "policy": {"{"} "max_identities_per_machine": 10 {"}"}
{"}"}</code></pre>
                <pre class="overflow-x-auto rounded-lg bg-gray-950 p-5 text-xs text-gray-300"><code>{"{"}
  "verified": true,
  "admitted": true,
  "card": {"{"} "name": "...", "skills": [] {"}"},
  "wallet": {"{"} "solana": "...", "evm": "..." {"}"},
  "identity": {"{"} "total_logins": 4 {"}"},
  "readToken": "..."
{"}"}</code></pre>
              </div>
            </div>
          </section>

          <section id="testing" class="scroll-mt-24 space-y-8">
            <div class="flex items-baseline justify-between gap-6">
              <h2 class="text-xl font-light tracking-widest text-gray-900">TESTING</h2>
              <span class="hidden sm:block h-px flex-1 bg-gray-100"></span>
            </div>
            <div class="grid md:grid-cols-3 gap-4">
              <a href="/verify" class="rounded-lg border border-gray-100 p-5 transition-colors hover:border-gray-300">
                <p class="text-sm text-gray-900 font-light tracking-wide">Verify payloads</p>
                <p class="mt-2 text-xs text-gray-500 font-light leading-relaxed">Paste a signed login payload and inspect policy, identity, wallet, token, and attestation output.</p>
              </a>
              <a href="/lookup" class="rounded-lg border border-gray-100 p-5 transition-colors hover:border-gray-300">
                <p class="text-sm text-gray-900 font-light tracking-wide">Lookup hosted cards</p>
                <p class="mt-2 text-xs text-gray-500 font-light leading-relaxed">Fetch a public agent card or test token-gated branch access.</p>
              </a>
              <a href="/console" class="rounded-lg border border-gray-100 p-5 transition-colors hover:border-gray-300">
                <p class="text-sm text-gray-900 font-light tracking-wide">Operate identities</p>
                <p class="mt-2 text-xs text-gray-500 font-light leading-relaxed">Review overview, branches, audit, tokens, status, and raw hosted identity state.</p>
              </a>
            </div>
          </section>
        </div>
      </div>
    </section>
  </div>
</Layout>
