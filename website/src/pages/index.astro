---
import Layout from '../layouts/Layout.astro';
---

<Layout title="NEWTYPE AI — Agent identity for the internet" hideNav={true}>

  <!-- Section 1: Full-screen image -->
  <div class="h-screen w-full relative overflow-hidden">
    <img src="/Paradise_Lost_12.jpg" alt="Classical engraving from Paradise Lost by Gustave Doré" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/20"></div>
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </div>

  <!-- Section 2: Scroll-reveal text -->
  <div class="min-h-screen flex items-center justify-center" id="reveal-section">
    <div class="max-w-3xl mx-auto px-8 py-32 space-y-10">
      <p class="reveal-line text-3xl md:text-5xl font-bold tracking-tight text-gray-200 transition-colors duration-500 leading-tight">
        Local-first Agent Identity
      </p>
      <p class="reveal-line text-xl md:text-2xl font-light text-gray-200 transition-colors duration-500 leading-relaxed">
        No human. No server. No IdP.
      </p>
      <p class="reveal-line text-xl md:text-2xl font-light text-gray-200 transition-colors duration-500 leading-relaxed">
        Created &amp; managed by agents.
      </p>
    </div>
  </div>

  <!-- Section 3: Two audience cards -->
  <section class="max-w-3xl mx-auto px-8 py-32">
    <div class="grid md:grid-cols-2 gap-8">
      <a href="/nit" class="block border border-gray-100 rounded-lg p-8 hover:border-gray-300 transition-colors group">
        <p class="text-xs text-gray-400 tracking-wider mb-3">FOR AGENTS</p>
        <p class="text-lg text-gray-900 font-light tracking-wide mb-3 group-hover:text-gray-700 transition-colors">nit</p>
        <p class="text-sm text-gray-500 font-light leading-relaxed">Git for agent identity. Generate your keypair, commit your agent card, push to a permanent URL. One CLI — identity, wallet, signing, personas.</p>
        <p class="text-sm text-gray-500 font-light mt-4 group-hover:text-gray-700 transition-colors">Get started &rarr;</p>
      </a>
      <a href="/nit-sdk" class="block border border-gray-100 rounded-lg p-8 hover:border-gray-300 transition-colors group">
        <p class="text-xs text-gray-400 tracking-wider mb-3">FOR APPS</p>
        <p class="text-lg text-gray-900 font-light tracking-wide mb-3 group-hover:text-gray-700 transition-colors">nit-sdk</p>
        <p class="text-sm text-gray-500 font-light leading-relaxed">Verify agent identity with one API call. Get the agent card, wallet addresses, and a read token. No OAuth, no crypto library — just a POST request.</p>
        <p class="text-sm text-gray-500 font-light mt-4 group-hover:text-gray-700 transition-colors">Integration guide &rarr;</p>
      </a>
    </div>
  </section>

</Layout>

<script>
  const lines = document.querySelectorAll('.reveal-line');

  const observer = new IntersectionObserver((entries) => {
    // Find which lines are currently intersecting
    const visible: Element[] = [];
    lines.forEach((line) => {
      if (line.getBoundingClientRect().top < window.innerHeight * 0.65) {
        visible.push(line);
      }
    });

    // The last visible line is the "active" one
    lines.forEach((line, i) => {
      if (visible.length === 0) {
        // None scrolled into view yet — all gray
        line.classList.remove('text-gray-900', 'font-bold');
        line.classList.add('text-gray-200');
      } else if (line === visible[visible.length - 1]) {
        // Current/active line — dark and bold
        line.classList.remove('text-gray-200');
        line.classList.add('text-gray-900');
      } else if (visible.includes(line)) {
        // Already scrolled past — dimmed
        line.classList.remove('text-gray-900');
        line.classList.add('text-gray-300');
      } else {
        // Not yet reached
        line.classList.remove('text-gray-900');
        line.classList.add('text-gray-200');
      }
    });
  }, { threshold: [0, 0.5, 1] });

  // Use scroll listener for precise control
  function updateLines() {
    const visible: Element[] = [];
    lines.forEach((line) => {
      const rect = line.getBoundingClientRect();
      if (rect.top < window.innerHeight * 0.6) {
        visible.push(line);
      }
    });

    lines.forEach((line) => {
      // Reset all classes
      line.classList.remove('text-gray-900', 'text-gray-300', 'text-gray-200');

      if (visible.length === 0) {
        line.classList.add('text-gray-200');
      } else if (line === visible[visible.length - 1]) {
        line.classList.add('text-gray-900');
      } else if (visible.includes(line)) {
        line.classList.add('text-gray-300');
      } else {
        line.classList.add('text-gray-200');
      }
    });
  }

  window.addEventListener('scroll', updateLines, { passive: true });
  updateLines();
</script>
