---
interface Props {
  title: string;
  description?: string;
  hideNav?: boolean;
  hideFooter?: boolean;
  ogImage?: string;
}

const {
  title,
  description = "Okta for agents. Local identity with central control: register every agent, verify access, audit actions, and revoke credentials.",
  hideNav = false,
  hideFooter = false,
  ogImage,
} = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site).toString();
const ogImageURL = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
const developerPaths = ['/developers', '/nit', '/sdk', '/nit-sdk'];
const consolePaths = ['/console', '/lookup', '/explorer', '/verify', '/overview', '/audit', '/tokens', '/status'];
const isDeveloperPath = developerPaths.some((path) => currentPath === path || currentPath.startsWith(`${path}/`));
const isConsolePath = consolePaths.some((path) => currentPath === path || currentPath.startsWith(`${path}/`));
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NEWTYPE AI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}

    <meta name="twitter:card" content={ogImageURL ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen bg-white">
    {!hideNav && (
      <nav class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-sm border-b border-gray-100">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 md:px-8 h-14 flex items-center justify-between gap-3 md:gap-6">
          <a href="/" class="text-[11px] sm:text-sm font-medium tracking-[0.22em] sm:tracking-widest text-gray-900 hover:text-gray-600 transition-colors shrink-0">NEWTYPE AI</a>
          <div class="flex items-center gap-2 sm:gap-5 md:gap-8">
            <a href="/" class:list={["hidden sm:inline text-xs tracking-wider transition-colors", currentPath === "/" ? "text-gray-900" : "text-gray-400 hover:text-gray-700"]}>Product</a>
            <a href="/developers" class:list={["text-[10px] sm:text-xs tracking-[0.12em] sm:tracking-wider transition-colors", isDeveloperPath ? "text-gray-900" : "text-gray-400 hover:text-gray-700"]}>Developers</a>
            <a href="/console" class:list={["text-[10px] sm:text-xs tracking-[0.12em] sm:tracking-wider transition-colors", isConsolePath ? "text-gray-900" : "text-gray-400 hover:text-gray-700"]}>Console</a>
            <a href="/docs" class:list={["text-[10px] sm:text-xs tracking-[0.12em] sm:tracking-wider transition-colors", currentPath.startsWith("/docs") ? "text-gray-900" : "text-gray-400 hover:text-gray-700"]}>Docs</a>
          </div>
        </div>
      </nav>
    )}

    <main class:list={[hideNav ? "" : "pt-14"]}>
      <slot />
    </main>

    {!hideFooter && (
    <footer class="border-t border-gray-100">
      <div class="max-w-5xl mx-auto px-8 py-12">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-8">
          <div class="space-y-3">
            <p class="text-xs font-medium tracking-widest text-gray-900">NEWTYPE AI</p>
            <p class="text-xs text-gray-400 font-light leading-relaxed max-w-xs">Local identity. Central control.</p>
          </div>
          <div class="flex gap-12">
            <div class="space-y-3">
              <p class="text-xs text-gray-500 tracking-wider">Platform</p>
              <div class="flex flex-col gap-2">
                <a href="/" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">Product</a>
                <a href="/developers" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">Developers</a>
                <a href="/console" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">Console</a>
              </div>
            </div>
            <div class="space-y-3">
              <p class="text-xs text-gray-500 tracking-wider">Resources</p>
              <div class="flex flex-col gap-2">
                <a href="/docs" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">Docs</a>
                <a href="/status" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">Status</a>
                <a href="/protocol" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">Protocol</a>
                <a href="https://github.com/newtype-ai" target="_blank" rel="noopener" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">GitHub</a>
                <a href="https://www.npmjs.com/package/@newtype-ai/nit" target="_blank" rel="noopener" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">npm</a>
              </div>
            </div>
            <div class="space-y-3">
              <p class="text-xs text-gray-500 tracking-wider">Company</p>
              <div class="flex flex-col gap-2">
                <a href="/about" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">About</a>
              </div>
            </div>
          </div>
        </div>
        <div class="mt-12 pt-6 border-t border-gray-50">
          <p class="text-xs text-gray-300 font-light">&copy; 2026 newtype-ai &middot; MIT License</p>
        </div>
      </div>
    </footer>
    )}
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
