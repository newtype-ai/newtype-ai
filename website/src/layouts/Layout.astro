---
interface Props {
  title: string;
  description?: string;
  hideNav?: boolean;
  hideFooter?: boolean;
  ogImage?: string;
}

const {
  title,
  description = "Git for agent identity. One identity, any apps — self-sovereign, local-first, created and managed by agents.",
  hideNav = false,
  hideFooter = false,
  ogImage,
} = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site).toString();
const ogImageURL = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NEWTYPE AI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}

    <meta name="twitter:card" content={ogImageURL ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen bg-white">
    {!hideNav && (
      <nav class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-sm border-b border-gray-100">
        <div class="max-w-5xl mx-auto px-8 h-14 flex items-center justify-between gap-6">
          <a href="/" class="text-sm font-medium tracking-widest text-gray-900 hover:text-gray-600 transition-colors shrink-0">NEWTYPE AI</a>
          <div class="flex items-center gap-5 md:gap-8 overflow-x-auto">
            <a href="/nit" class:list={["text-xs tracking-wider transition-colors", currentPath.startsWith("/nit") && !currentPath.startsWith("/nit-sdk") ? "text-gray-900" : "text-gray-400 hover:text-gray-700"]}>nit</a>
            <a href="/nit-sdk" class:list={["text-xs tracking-wider transition-colors", currentPath.startsWith("/nit-sdk") ? "text-gray-900" : "text-gray-400 hover:text-gray-700"]}>SDK</a>
            <a href="/verify" class:list={["text-xs tracking-wider transition-colors", currentPath.startsWith("/verify") ? "text-gray-900" : "text-gray-400 hover:text-gray-700"]}>Verify</a>
            <a href="/explorer" class:list={["text-xs tracking-wider transition-colors", currentPath.startsWith("/explorer") ? "text-gray-900" : "text-gray-400 hover:text-gray-700"]}>Explorer</a>
            <a href="/overview" class:list={["text-xs tracking-wider transition-colors", currentPath.startsWith("/overview") ? "text-gray-900" : "text-gray-400 hover:text-gray-700"]}>Overview</a>
            <a href="/audit" class:list={["text-xs tracking-wider transition-colors", currentPath.startsWith("/audit") ? "text-gray-900" : "text-gray-400 hover:text-gray-700"]}>Audit</a>
            <a href="/tokens" class:list={["text-xs tracking-wider transition-colors", currentPath.startsWith("/tokens") ? "text-gray-900" : "text-gray-400 hover:text-gray-700"]}>Tokens</a>
            <a href="/status" class:list={["text-xs tracking-wider transition-colors", currentPath.startsWith("/status") ? "text-gray-900" : "text-gray-400 hover:text-gray-700"]}>Status</a>
            <a href="/docs" class:list={["text-xs tracking-wider transition-colors", currentPath.startsWith("/docs") ? "text-gray-900" : "text-gray-400 hover:text-gray-700"]}>Docs</a>
            <a href="/about" class:list={["text-xs tracking-wider transition-colors", currentPath.startsWith("/about") ? "text-gray-900" : "text-gray-400 hover:text-gray-700"]}>About</a>
          </div>
        </div>
      </nav>
    )}

    <main class:list={[hideNav ? "" : "pt-14"]}>
      <slot />
    </main>

    {!hideFooter && (
    <footer class="border-t border-gray-100">
      <div class="max-w-5xl mx-auto px-8 py-12">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-8">
          <div class="space-y-3">
            <p class="text-xs font-medium tracking-widest text-gray-900">NEWTYPE AI</p>
            <p class="text-xs text-gray-400 font-light leading-relaxed max-w-xs">Agents need native identities.</p>
          </div>
          <div class="flex gap-12">
            <div class="space-y-3">
              <p class="text-xs text-gray-500 tracking-wider">Products</p>
              <div class="flex flex-col gap-2">
                <a href="/nit" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">nit</a>
                <a href="/nit-sdk" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">nit-sdk</a>
                <a href="/protocol" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">rlp</a>
              </div>
            </div>
            <div class="space-y-3">
              <p class="text-xs text-gray-500 tracking-wider">Resources</p>
              <div class="flex flex-col gap-2">
                <a href="/docs" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">Documentation</a>
                <a href="/verify" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">Verifier</a>
                <a href="/explorer" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">Explorer</a>
                <a href="/overview" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">Overview</a>
                <a href="/audit" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">Audit</a>
                <a href="/tokens" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">Tokens</a>
                <a href="/status" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">Status</a>
                <a href="https://github.com/newtype-ai" target="_blank" rel="noopener" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">GitHub</a>
                <a href="https://www.npmjs.com/package/@newtype-ai/nit" target="_blank" rel="noopener" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">npm</a>
              </div>
            </div>
            <div class="space-y-3">
              <p class="text-xs text-gray-500 tracking-wider">Company</p>
              <div class="flex flex-col gap-2">
                <a href="/about" class="text-xs text-gray-400 font-light hover:text-gray-600 transition-colors">About</a>
              </div>
            </div>
          </div>
        </div>
        <div class="mt-12 pt-6 border-t border-gray-50">
          <p class="text-xs text-gray-300 font-light">&copy; 2026 newtype-ai &middot; MIT License</p>
        </div>
      </div>
    </footer>
    )}
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
