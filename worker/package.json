{
  "name": "newtype-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Agent identity card hosting on newtype-ai.org",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/newtype-ai/newtype-ai"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "npm run typecheck:worker && npm run typecheck:badge && npm run typecheck:card",
    "typecheck:worker": "tsc --noEmit",
    "typecheck:badge": "tsc --noEmit -p tsconfig.badge.json",
    "typecheck:card": "tsc --noEmit -p tsconfig.card.json",
    "test": "npm run typecheck && node --test tests/*.test.mjs",
    "test:contract": "node tests/contract/newtype-contract-harness.mjs",
    "build:badge": "VITE_ENTRY=badge vite build",
    "build:card": "VITE_ENTRY=card vite build",
    "build:all": "vite build",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@react-three/fiber": "^9.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.0",
    "meshline": "^3.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.172.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.52.1"
  }
}
